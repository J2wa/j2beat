# Server-side only. Add in Vercel project settings, then redeploy.
GEMINI_API_KEY=
# Optional Gemini fallback keys, used in number order.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# Connect the paid Neon key in Studio.
OPENROUTER_API_KEY=
# Required: choose a model that supports audio input, not a text-only model.
OPENROUTER_MODEL=


# Shared login password. Server-only; use a long, unique value.
USER_PASSWORD=
