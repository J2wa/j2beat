{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/expire-imports", "schedule": "*/15 * * * *" }
  ],
  "functions": {
    "api/annotate.ts": {
      "maxDuration": 300
    },
    "api/spotify.py": {
      "maxDuration": 300,
      "excludeFiles": "{node_modules/**,src/**,dist/**,tests/**,.git/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "BLOB_STORE_ID": "store_PntqkokZ1AMhBkcC"
  }
}
